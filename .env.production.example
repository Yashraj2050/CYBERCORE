# ─────────────────────────────────────────────────────────────────────────────
# CYBERCORE Production Environment Configuration Template
# Copy to .env.production and supply production secrets before deployment.
# Never commit real production secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application Core
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Required: Generate with `openssl rand -hex 32`
APP_SECRET_KEY=generate_a_64_character_hex_secret_here

# Required: Administrator API Key for report moderation and online backups
ADMIN_API_KEY=generate_a_strong_admin_api_token_here

# Persistent Storage (Must point to a persistent volume or block storage in containerized deployments)
DATABASE_PATH=/data/cybercore.db

# Strict Production CORS Whitelist (comma-separated production origins)
CORS_ORIGINS=https://cybercore.security,https://app.cybercore.security

# Reverse Proxy Trust Configuration (Comma-separated IPs or subnets for Nginx/Cloudflare/ALB)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Rate Limiting Controls
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_SCAN_PER_HOUR=120

# External Intelligence Service Credentials (Leave empty to operate in zero-knowledge heuristic mode)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
HIBP_API_KEY=
PHISHTANK_API_KEY=

# AI Cybersecurity Advisor
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=https://api.cybercore.security/api/v1
NODE_ENV=production
